<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://www.mule.org/schema/mule/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- FIXED: Use logical groupId -->
    <groupId>com.satish</groupId>
    <artifactId>worldtime-api</artifactId>
    <version>1.1.2</version>
    <packaging>mule-application</packaging>

    <name>worldtime-api</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <app.runtime>4.6.0</app.runtime>
        <mule.maven.plugin.version>3.8.2</mule.maven.plugin.version>

        <!-- API Manager Autodiscovery -->
        <anypoint.platform.api.id>20819664</anypoint.platform.api.id>

        <skipExchangeHash>true</skipExchangeHash>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.mule.tools.maven</groupId>
                <artifactId>mule-maven-plugin</artifactId>
                <version>${mule.maven.plugin.version}</version>
                <extensions>true</extensions>

                <configuration>
                    <cloudhub2Deployment>
                        <uri>https://anypoint.mulesoft.com</uri>
                        <provider>MC</provider>
                        <environment>Sandbox</environment>

                        <!-- IMPORTANT -->
                        <target>Cloudhub-US-East-2</target>

                        <muleVersion>${app.runtime}</muleVersion>

                        <!-- MUST BE UNIQUE -->
                        <applicationName>satish-worldtime-api-ch2</applicationName>

                        <replicas>1</replicas>
                        <vCores>0.1</vCores>

                        <properties>
                            <anypoint.platform.api.id>
                                ${anypoint.platform.api.id}
                            </anypoint.platform.api.id>
                        </properties>

                    </cloudhub2Deployment>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>org.mule.connectors</groupId>
            <artifactId>mule-http-connector</artifactId>
            <version>1.5.22</version>
            <classifier>mule-plugin</classifier>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>anypoint-exchange-v3</id>
            <url>https://maven.anypoint.mulesoft.com/api/v3/maven</url>
        </repository>

        <repository>
            <id>mulesoft-releases</id>
            <url>https://repository.mulesoft.org/releases/</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>mulesoft-releases</id>
            <url>https://repository.mulesoft.org/releases/</url>
        </pluginRepository>
    </pluginRepositories>

    <!-- REQUIRED for Exchange publish -->
    <distributionManagement>
        <repository>
            <id>anypoint-exchange</id>
            <url>
                https://maven.anypoint.mulesoft.com/api/v3/organizations/dbede75e-6b29-4063-ac16-b9cad78a7cc4/maven
            </url>
        </repository>
    </distributionManagement>

</project>
